# ==============================================================================
# HEVN AI — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI & LLM Inference (Google AI Studio / Gemma)
# ------------------------------------------------------------------------------
GEMMA_API_KEY=your_google_ai_studio_api_key_here
GEMMA_MODEL=gemma-4-31b-it
# Optional audio transcription API key and model override (default: gemini-2.0-flash)
GEMINI_API_KEY=your_gemini_api_key_here_if_different_from_gemma
GEMINI_TRANSCRIPTION_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# 2. Messaging Channels
# ------------------------------------------------------------------------------
# Telegram Bot API
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_WEBHOOK_SECRET=generate_a_random_32_char_alphanumeric_secret

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=EAAB...
WHATSAPP_PHONE_NUMBER_ID=109876543210987
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_handshake_verify_token
WHATSAPP_APP_SECRET=your_meta_app_secret_for_hmac_sha256

# ------------------------------------------------------------------------------
# 3. Google Calendar OAuth 2.0 Integration
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_oauth_client_secret
GOOGLE_REDIRECT_URI=https://app.hevn.ai/auth/google/callback

# ------------------------------------------------------------------------------
# 4. Outbound Voice Synthesis (TTS)
# ------------------------------------------------------------------------------
# ElevenLabs TTS (Primary High-Fidelity Provider)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Google Cloud Text-to-Speech (Secondary / Fallback Provider)
GOOGLE_TTS_API_KEY=your_google_cloud_tts_api_key

# ------------------------------------------------------------------------------
# 5. Database (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Main application connection string (enforces Row-Level Security via withUserScope)
DATABASE_URL=postgresql://postgres.project:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Background worker / Scheduler connection string (bypasses RLS for cross-tenant job queue)
SCHEDULER_DATABASE_URL=postgresql://postgres.project:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# ------------------------------------------------------------------------------
# 6. Security & Internal Administration
# ------------------------------------------------------------------------------
# 32-byte secret for AES-256-GCM token encryption and OAuth state signing
ENCRYPTION_KEY=your_32_byte_secret_key_here_must_be_kept_safe

# Secret API key required for all internal /api/admin/* endpoints
ADMIN_API_KEY=your_super_secret_hevn_admin_api_key_minimum_32_characters

# ------------------------------------------------------------------------------
# 7. Application & Worker Runtime
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
BOT_NAME=Hevn
LOG_LEVEL=info
WORKER_CONCURRENCY=5

# ------------------------------------------------------------------------------
# 8. Webhook Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
