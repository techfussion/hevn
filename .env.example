GEMMA_API_KEY=your_google_ai_studio_key_here
GEMMA_MODEL=gemma-4-31b-it
# Smaller/faster alternative if latency matters more than reasoning depth:
# GEMMA_MODEL=gemma-4-12b-it

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_botfather_token_here
TELEGRAM_WEBHOOK_SECRET=change_me_to_a_random_string

# --- WhatsApp Cloud API ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change_me_to_a_random_string
WHATSAPP_APP_SECRET=

# --- Database (Supabase Postgres connection string) ---
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- App config ---
PORT=3000
NODE_ENV=development
# Bot persona name
BOT_NAME=Hevn
LOG_LEVEL=info

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20
